#!/usr/bin/make -f
# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 The Blueberry Pie OS Authors

include /usr/share/pietoolchain/rules.mk

SRC    := $(SRCROOT)/icu/icu4c/source
HOST   := $(OBJ)/host
TARGET := $(OBJ)/target
PIE_MAKE := MAKEFILES=$(CURDIR)/debian/icu.mk PIE_SRC=$(CURDIR)/debian/src
PIE_CPPFLAGS := -I$(CURDIR)/debian/src
HOSTCC := clang-21
HOSTCXX := clang++-21
ICU_VERS := 78

ICU_DEFS := -DU_SHOW_CPLUSPLUS_API=1 -DU_SHOW_INTERNAL_API=1 -DUCONFIG_NO_MF2=1
TARGET_FLAGS := $(ARCHFLAGS) -isysroot $(SDK) $(MINVER) $(TARGET_OS_DEFS) $(ICU_DEFS) \
	-DU_TIMEZONE=timezone -DICU_DATA_DIR=\\\"/usr/share/icu\\\" -g -Os -fno-exceptions -fvisibility=hidden
CONFIG_FLAGS := --disable-renaming --disable-extras --disable-layout --disable-layoutex \
	--disable-samples --disable-tests --with-data-packaging=archive

DYLIB := $(OBJ)/libicucore.A.dylib
LEFT_OUT_H := ualoc.h urbtok.h uameasureformat.h uameasureunit.h uatimeunitformat.h udatintv.h uplrule.h
DATA  := $(HOST)/data/out/icudt$(ICU_VERS)l.dat

all: $(DYLIB) $(DATA)

$(HOST)/.built:
	rm -rf $(HOST)
	mkdir -p $(HOST)
	cd $(HOST) && ICU_DATA_FILTER_FILE=$(CURDIR)/debian/icu-data-filter.json CC=$(HOSTCC) CXX=$(HOSTCXX) CPPFLAGS="$(PIE_CPPFLAGS)" CFLAGS="$(ICU_DEFS) -O2" \
		CXXFLAGS="$(ICU_DEFS) -O2 -std=c++17" $(SRC)/configure $(CONFIG_FLAGS) > configure.log
	: > $(HOST)/common/svchook.mk
	env -u MAKEFLAGS $(PIE_MAKE) $(MAKE) -j$(JOBS) -C $(HOST) > $(HOST)/make.log
	touch $@
$(DATA): $(HOST)/.built

$(TARGET)/.built: $(HOST)/.built debian/printvar.mk
	rm -rf $(TARGET)
	mkdir -p $(TARGET)
	cd $(TARGET) && CC=$(CC) CXX=$(CXX) CPPFLAGS="$(PIE_CPPFLAGS)" CFLAGS="$(TARGET_FLAGS)" \
		CXXFLAGS="$(TARGET_FLAGS) -std=c++17 -fvisibility-inlines-hidden" \
		LDFLAGS="$(ARCHFLAGS) -isysroot $(SDK) $(MINVER)" \
		$(SRC)/configure --host=aarch64-apple-darwin --build=$(shell uname -m)-pc-linux-gnu \
		--with-cross-build=$(HOST) --disable-tools $(CONFIG_FLAGS) > configure.log
	: > $(TARGET)/common/svchook.mk
	set -e; for d in stubdata common i18n io; do \
		objs=$$(env -u MAKEFLAGS $(MAKE) -s -C $(TARGET)/$$d -f Makefile -f $(SRCROOT)/debian/printvar.mk \
			print-OBJECTS | tr ' ' '\n' | grep '\.o$$'); \
		[ $$d != common ] || objs="$$objs ualoc.o"; \
		env -u MAKEFLAGS $(PIE_MAKE) $(MAKE) -j$(JOBS) -C $(TARGET)/$$d $$objs > $(TARGET)/$$d.log; \
		for o in $$objs; do echo $(TARGET)/$$d/$$o; done >> $(TARGET)/objects.list; \
	done
	touch $@

$(DYLIB): $(TARGET)/.built
	$(CXX) $(BASE_LDFLAGS) -dynamiclib -current_version $(ICU_VERS).1 -compatibility_version 1 \
		-Wl,-dead_strip \
		-install_name /usr/lib/libicucore.A.dylib -o $@ -filelist $(TARGET)/objects.list

install: all
	install -d $(ROOT)/usr/lib $(ROOT)/usr/share/icu $(ROOT)/usr/local/include/unicode
	install -m 755 $(DYLIB) $(ROOT)/usr/lib/
	ln -sf libicucore.A.dylib $(ROOT)/usr/lib/libicucore.dylib
	install -m 444 $(DATA) $(ROOT)/usr/share/icu/
	install -m 644 $(filter-out $(addprefix %/,$(LEFT_OUT_H)),$(wildcard $(SRC)/common/unicode/*.h $(SRC)/i18n/unicode/*.h \
		$(SRC)/io/unicode/*.h)) debian/src/unicode/*.h $(ROOT)/usr/local/include/unicode/

.PHONY: all install
